/dts-v1/;

/ {
	model = "MT6877";
	compatible = "mediatek,MT6877";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\tvmalloc=400M swiotlb=noforce \t\t\ttransparent_hugepage=never \t\t\tinitcall_debug=1 pelt=8 \t\t\t8250.nr_uarts=2 \t\t\tprintk.devkmsg=on \t\t\tfirmware_class.path=/vendor/firmware \t\t\tmemblock_memsize=procfs \t\t\tfault_around_bytes=32768 \t\t\tkswapd_cpumask=0x3f             kcompactd_cpumask=0x3f \t\t\trestrict_cma_redirect \t\t\tcgroup.memory=nokmem \t\t\tinit_on_alloc=0 \t\t\tloop.max_part=7";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x6e>;
	};

	mgm {
		compatible = "arm,physical-memory-group-manager";
		phandle = <0xab>;
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x02>;

		opp0 {
			opp-hz = <0x00 0x1dcd6500>;
			opp-microvolt = <0x9eb10>;
		};

		opp1 {
			opp-hz = <0x00 0x26be3680>;
			opp-microvolt = <0x9eb10>;
		};

		opp2 {
			opp-hz = <0x00 0x2c1b8100>;
			opp-microvolt = <0xa4cb8>;
		};

		opp3 {
			opp-hz = <0x00 0x35a4e900>;
			opp-microvolt = <0xac6ca>;
		};

		opp4 {
			opp-hz = <0x00 0x3a699d00>;
			opp-microvolt = <0xb1008>;
		};

		opp5 {
			opp-hz = <0x00 0x3ec38140>;
			opp-microvolt = <0xb40dc>;
		};

		opp6 {
			opp-hz = <0x00 0x448b9b80>;
			opp-microvolt = <0xb8a1a>;
		};

		opp7 {
			opp-hz = <0x00 0x4b1a1300>;
			opp-microvolt = <0xbebc2>;
		};

		opp8 {
			opp-hz = <0x00 0x4e150380>;
			opp-microvolt = <0xc1c96>;
		};

		opp9 {
			opp-hz = <0x00 0x53dd1dc0>;
			opp-microvolt = <0xc65d4>;
		};

		opp10 {
			opp-hz = <0x00 0x5995f5c0>;
			opp-microvolt = <0xcaf12>;
		};

		opp11 {
			opp-hz = <0x00 0x5f5e1000>;
			opp-microvolt = <0xcf850>;
		};

		opp12 {
			opp-hz = <0x00 0x6581b7c0>;
			opp-microvolt = <0xda336>;
		};

		opp13 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xe1d48>;
		};

		opp14 {
			opp-hz = <0x00 0x716d79c0>;
			opp-microvolt = <0xec82e>;
		};

		opp15 {
			opp-hz = <0x00 0x77359400>;
			opp-microvolt = <0xf4240>;
		};
	};

	opp_table1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x07>;

		opp0 {
			opp-hz = <0x00 0x26be3680>;
			opp-microvolt = <0x9eb10>;
		};

		opp1 {
			opp-hz = <0x00 0x2c1b8100>;
			opp-microvolt = <0xa344e>;
		};

		opp2 {
			opp-hz = <0x00 0x363d7f80>;
			opp-microvolt = <0xac6ca>;
		};

		opp3 {
			opp-hz = <0x00 0x3dfd2400>;
			opp-microvolt = <0xb2872>;
		};

		opp4 {
			opp-hz = <0x00 0x43f30500>;
			opp-microvolt = <0xb71b0>;
		};

		opp5 {
			opp-hz = <0x00 0x4d7c6d00>;
			opp-microvolt = <0xbebc2>;
		};

		opp6 {
			opp-hz = <0x00 0x553c1180>;
			opp-microvolt = <0xc4d6a>;
		};

		opp7 {
			opp-hz = <0x00 0x5bca8900>;
			opp-microvolt = <0xcaf12>;
		};

		opp8 {
			opp-hz = <0x00 0x62f19700>;
			opp-microvolt = <0xcf850>;
		};

		opp9 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xd418e>;
		};

		opp10 {
			opp-hz = <0x00 0x713fb300>;
			opp-microvolt = <0xd59f8>;
		};

		opp11 {
			opp-hz = <0x00 0x77359400>;
			opp-microvolt = <0xd8acc>;
		};

		opp12 {
			opp-hz = <0x00 0x80266580>;
			opp-microvolt = <0xdbba0>;
		};

		opp13 {
			opp-hz = <0x00 0x8583b000>;
			opp-microvolt = <0xe975a>;
		};

		opp14 {
			opp-hz = <0x00 0x8a486400>;
			opp-microvolt = <0xf5aaa>;
		};

		opp15 {
			opp-hz = <0x00 0x8f0d1800>;
			opp-microvolt = <0x100590>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0a>;
		};

		cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0b>;
		};

		cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0c>;
		};

		cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0d>;
		};

		cpu@004 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0e>;
		};

		cpu@005 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
			phandle = <0x0f>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x600>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x07>;
			dynamic-power-coefficient = <0x113>;
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x08 0x09 0x05 0x06>;
			phandle = <0x10>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a76";
			reg = <0x700>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x07>;
			dynamic-power-coefficient = <0x113>;
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x08 0x09 0x05 0x06>;
			phandle = <0x11>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0a>;
				};

				core1 {
					cpu = <0x0b>;
				};

				core2 {
					cpu = <0x0c>;
				};

				core3 {
					cpu = <0x0d>;
				};

				core4 {
					cpu = <0x0e>;
				};

				core5 {
					cpu = <0x0f>;
				};

				doe {
					phandle = <0x10f>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				doe {
					phandle = <0x110>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x640>;
				phandle = <0x03>;
			};

			cpuoff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x578>;
				phandle = <0x08>;
			};

			clusteroff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x834>;
				phandle = <0x04>;
			};

			clusteroff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x76c>;
				phandle = <0x09>;
			};

			mcusysoff {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010002>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0xfa0>;
				phandle = <0x05>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010100>;
				local-timer-stop;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x578>;
				min-residency-us = <0xffffffff>;
				phandle = <0x06>;
			};
		};
	};

	mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		suspend-method = "enable";
		logger-enable-states = "mcusysoff";
		irq-remain = <0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23>;
		resource-ctrl = <0x24 0x25 0x26 0x27 0x28>;
		constraints = <0x29 0x2a 0x2b>;
		spm-cond = <0x2c 0x2d>;
		cg-shift = <0x00>;
		pll-shift = <0x10>;
		mcusys-cnt-chk = <0x01>;
		phandle = <0x111>;

		cpupm-sysram@0011b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0x112>;
		};

		lpm_sysram@0011b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0x113>;
		};

		irq-remain-list {

			edge_keypad {
				target = <0x2e>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0x12>;
			};

			edge_mdwdt {
				target = <0x2f>;
				value = <0x01 0x00 0x80000000 0x2000000>;
				phandle = <0x13>;
			};

			level_vpu_core0 {
				target = <0x30>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x14>;
			};

			level_vpu_core1 {
				target = <0x31>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x15>;
			};

			level_mtk_mdla0 {
				target = <0x32>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x16>;
			};

			level_edma0 {
				target = <0x33>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x17>;
			};

			level_mali0 {
				target = <0x34>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x18>;
			};

			level_mali1 {
				target = <0x34>;
				value = <0x00 0x01 0x00 0x00>;
				phandle = <0x19>;
			};

			level_mali2 {
				target = <0x34>;
				value = <0x00 0x02 0x00 0x00>;
				phandle = <0x1a>;
			};

			level_mali3 {
				target = <0x34>;
				value = <0x00 0x03 0x00 0x00>;
				phandle = <0x1b>;
			};

			level_mali4 {
				target = <0x34>;
				value = <0x00 0x04 0x00 0x00>;
				phandle = <0x1c>;
			};

			level_i2c0 {
				target = <0x35>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x1d>;
			};

			level_btif_tx {
				target = <0x36>;
				value = <0x00 0x01 0x00 0x00>;
				phandle = <0x1e>;
			};

			level_btif_rx {
				target = <0x36>;
				value = <0x00 0x02 0x00 0x00>;
				phandle = <0x1f>;
			};

			level_bt {
				target = <0x37>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x20>;
			};

			level_cam1 {
				target = <0x38>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x21>;
			};

			level_cam2 {
				target = <0x39>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x22>;
			};

			level-dsi0 {
				target = <0x3a>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0x23>;
			};
		};

		resource-ctrl-list {

			bus26m {
				id = <0x00>;
				value = <0x00>;
				phandle = <0x24>;
			};

			infra {
				id = <0x01>;
				value = <0x00>;
				phandle = <0x25>;
			};

			syspll {
				id = <0x02>;
				value = <0x00>;
				phandle = <0x26>;
			};

			dram_s0 {
				id = <0x03>;
				value = <0x00>;
				phandle = <0x27>;
			};

			dram_s1 {
				id = <0x04>;
				value = <0x00>;
				phandle = <0x28>;
			};
		};

		constraint-list {

			rc_bus26m {
				rc-name = "bus26m";
				id = <0x00>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x29>;
			};

			rc_syspll {
				rc-name = "syspll";
				id = <0x01>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x2a>;
			};

			rc_dram {
				rc-name = "dram";
				id = <0x02>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x2b>;
			};
		};

		spm-cond-list {

			spm_cond_cg {
				cg-name = "MTCMOS_1\0MTCMOS_2\0INFRA_0\0INFRA_1\0INFRA_2\0INFRA_3\0INFRA_4\0INFRA_5\0MMSYS_0\0MMSYS_1\0MMSYS_2\0MMSYS_3\0MMSYS_4\0MMSYS_5\0MMSYS_6\0MMSYS_7";
				phandle = <0x2c>;
			};

			spm_cond_pll {
				pll-name = "UNIVPLL\0MFGPLL1\0MFGPLL4\0MSDCPLL\0TVPLL\0MMPLL";
				phandle = <0x2d>;
			};
		};
	};

	mcusys-ctrl@0c53a000 {
		compatible = "mediatek,mcusys-ctrl";
		reg = <0x00 0xc53a000 0x00 0x1000>;
		phandle = <0x114>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x00>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04 0x00>;
		cpus = <0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x3e605000>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x115>;

		ssmr-reserved-cma_memory {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x10000000>;
			alignment = <0x00 0x1000000>;
			alloc-range = <0x00 0xc0000000 0x00 0x10000000>;
			phandle = <0x92>;
		};

		reserve-memory-mcupm_share {
			compatible = "mediatek,reserve-memory-mcupm_share";
			no-map;
			status = "okay";
			size = <0x00 0x610000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
		};

		ion-carveout-heap {
			compatible = "mediatek,ion-carveout-heap";
			no-map;
			size = <0x00 0xc000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x00 0x780000>;
			alignment = <0x00 0x100000>;
			alloc-ranges = <0x00 0x50000000 0x00 0x40000000>;
			phandle = <0xb7>;
		};

		reserve-memory-scp_share {
			compatible = "mediatek,reserve-memory-scp_share";
			no-map;
			size = <0x00 0x3c0000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x50000000 0x00 0x40000000>;
		};

		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			no-map;
			status = "okay";
			size = <0x00 0x510000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
		};

		reserve-memory-adsp_share {
			compatible = "mediatek,reserve-memory-adsp_share";
			no-map;
			size = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x40000000>;
			alignment = <0x00 0x10000>;
		};

		wifi-reserve-memory {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x00 0xf20000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
			phandle = <0xbc>;
		};

		gps-reserve-memory {
			compatible = "mediatek,gps-reserve-memory";
			no-map;
			size = <0x00 0x100000>;
			alignment = <0x00 0x100000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
			phandle = <0xbf>;
		};

		ccci-dpmaif-cache-memory {
			compatible = "mediatek,dpmaif-resv-cache-mem";
			size = <0x00 0x190000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0xf0000000>;
			phandle = <0x116>;
		};

		ccci-dpmaif-nocache-memory {
			compatible = "mediatek,dpmaif-resv-nocache-mem";
			no-map;
