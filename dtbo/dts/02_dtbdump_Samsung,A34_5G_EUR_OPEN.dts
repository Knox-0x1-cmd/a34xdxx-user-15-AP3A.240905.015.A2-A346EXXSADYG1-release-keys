					battery,dchg_high_temp_recovery = <0x3e8 0x3e8 0x226 0x226>;
					battery,dchg_high_batt_temp = <0x3e8 0x3e8 0x3e8 0x3e8>;
					battery,dchg_high_batt_temp_recovery = <0x3e8 0x3e8 0x3e8 0x3e8>;
