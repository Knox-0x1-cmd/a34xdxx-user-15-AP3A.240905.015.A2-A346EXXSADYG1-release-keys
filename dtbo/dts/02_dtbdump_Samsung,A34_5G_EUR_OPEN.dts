				input_booster {
					status = "okay";
					compatible = "input_booster";
					resValcount = "2";
					max_resource_count = "2";
					max_cluster_count = "3";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					cpu_cluster_policy = "6,0";
					ib_release_values = "-1,16";
					allowed_resources = "0,1";

					booster@1 {
						booster,label = "Disable_Mode";
						booster,mode = "1";

						booster_key@1 {
							input_booster,label = "Touch_Disable";
							input_booster,type = <0x02>;
							input_booster,head_time = <0x00>;
							input_booster,tail_time = <0x00>;

							input_booster,resource {
								compatible = "resource";

								resource@1 {
									resource,label = "CPU";
									resource,id = "0";
									resource,value = <0x00 0x00>;
								};
							};
						};
					};

					booster@2 {
